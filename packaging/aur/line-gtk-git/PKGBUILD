# Maintainer: MidnightTale <mntale@pm.me>
pkgname=line-gtk-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Unofficial native LINE client for Linux (GTK4 / Libadwaita), git version'
arch=('x86_64')
url='https://github.com/MidnightTale/Line-GTK'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'ffmpeg' 'hicolor-icon-theme')
makedepends=('cargo' 'deno' 'git')
optdepends=(
  'poppler: PDF preview in media viewer'
  'gst-plugins-good: extra video playback codecs'
  'gst-libav: extra video playback codecs'
)
provides=('line-gtk')
conflicts=('line-gtk')
options=('!lto')
source=("git+https://github.com/MidnightTale/Line-GTK.git")
sha256sums=('SKIP')

pkgver() {
  cd Line-GTK
  local ver
  ver="$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)"
  printf "%s.r%s.g%s" "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd Line-GTK
  export RUSTUP_TOOLCHAIN=stable
  # Prefer lockfile when present; otherwise resolve deps for this snapshot.
  if [[ -f Cargo.lock ]]; then
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  else
    cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
  fi
}

build() {
  cd Line-GTK
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  if [[ -f Cargo.lock ]]; then
    cargo build --frozen --release
  else
    cargo build --release
  fi
  ./scripts/build-sidecar.sh
}

package() {
  cd Line-GTK

  install -Dm755 target/release/line-gtk "$pkgdir/usr/bin/line-gtk"

  install -d "$pkgdir/usr/share/line-gtk"
  cp -a protocol "$pkgdir/usr/share/line-gtk/protocol"
  cp -a assets "$pkgdir/usr/share/line-gtk/assets"

  rm -rf "$pkgdir/usr/share/line-gtk/protocol/node_modules" \
         "$pkgdir/usr/share/line-gtk/protocol/.deno" 2>/dev/null || true

  install -Dm644 packaging/dev.linegtk.LineGtk.desktop \
    "$pkgdir/usr/share/applications/dev.linegtk.LineGtk.desktop"

  for size in 48x48 64x64 128x128 256x256; do
    install -Dm644 "assets/icons/hicolor/${size}/apps/line-gtk.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/line-gtk.png"
  done
  install -Dm644 assets/icons/hicolor/scalable/apps/line-gtk.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/line-gtk.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
